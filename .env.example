# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en          # en | bn

# ---------- Supabase ----------
# Local values are printed by `pnpm supabase start` (or `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx    # or legacy anon key
SUPABASE_SECRET_KEY=sb_secret_xxx                          # SERVER ONLY. or legacy service_role key

# ---------- Anti-abuse (optional) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Payments ----------
PAYMENT_GATEWAY=mock                  # mock (dev/test only) | sslcommerz
SSLCOMMERZ_MODE=sandbox               # sandbox | live
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---------- Demo / scripts ----------
DEMO_RESTAURANT_ID=00000000-0000-4000-8000-000000000001
DEMO_STAFF_PASSWORD=ChangeMe!2026
